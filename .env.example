# ════════════════════════════════════════════════════════════
#  VLAD OS — configuration   (cp .env.example .env)
#  Seul VLAD_USER est vraiment utile au départ : tout le reste est facultatif.
#  Chaque connecteur non rempli est simplement désactivé (le widget affiche « à configurer »).
# ════════════════════════════════════════════════════════════

# ── Qui es-tu ──
VLAD_USER=Alex                      # ton prénom : VLAD s'adresse à toi
# VLAD_COMPANY=Mon Studio           # ton entreprise (facultatif)
# VLAD_CALENDAR=Alex                # nom du calendrier de l'app Calendrier du Mac où VLAD crée les événements

# ── Le cerveau : Claude Code (CLI `claude`, connecté avec « claude auth login ») ──
# VLAD_CLAUDE=claude                # chemin du binaire si besoin
# VLAD_FAST=claude-sonnet-5         # la voix (process persistant, réponses courtes)
# VLAD_DEEP=claude-opus-5           # l'analyse de documents
# VLAD_MEMORY_DIR=                  # dossier de notes .md en plus du vault (ex. ~/.claude/projects/<projet>/memory)

# ── Voix 100 % locale ──
# VLAD_PYTHON=.venv/bin/python      # créé par setup.sh
# VLAD_WHISPER=medium               # transcription : tiny | base | small | medium (plus précis, plus lent)
# Voix naturelle ElevenLabs (payante, facultative) — sinon voix locale Edge / Kokoro / macOS
# ELEVEN_KEY=
# ELEVEN_VOICE=

# ── Agenda : adresse(s) iCal secrète(s) ──
# Google Agenda → Paramètres du calendrier → « Adresse secrète au format iCal »
# Plusieurs calendriers, étiquetés : pro=https://…,perso=https://…
# CALENDAR_ICS=
# CALENDLY_TOKEN=                   # rendez-vous clients (jeton personnel Calendly)

# ── Mails (Gmail, lecture + labels VLAD/*) : mot de passe d'application Google ──
# MAIL_USER=toi@gmail.com
# MAIL_APP_PASSWORD=
# MAIL_USER2=                       # 2e boîte facultative
# MAIL_APP_PASSWORD2=

# ── Telegram : VLAD dans ta poche ──
# TELEGRAM_TOKEN=                   # jeton du bot (@BotFather)
# TELEGRAM_PAIR=                    # code secret à envoyer une fois au bot pour l'appairer
# BRIEF_HOUR=8                      # brief du matin
# CHECKIN_HOUR=21                   # check-in du soir
# CONSOLIDE_HOUR=22                 # VLAD relit sa journée et met son carnet à jour
# RAPPEL_MINUTES=60                 # rappel avant rendez-vous (ex. 60,15)

# ── Accès depuis l'extérieur (tunnel Cloudflare, etc.) ──
# VITE_VLAD_PUBLIC_URL=https://vlad.mondomaine.fr

# ── Widgets ──
# GITHUB_TOKEN=                     # lecture seule ; sinon VLAD utilise `gh auth token`
# VLAD_CONTRACTS_DIR=               # dossier <Client>/<contrat>.pdf affiché dans le Vault
# VLAD_PORT=8788                    # port du pont
