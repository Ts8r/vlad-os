{
  "name": "vlad-os",
  "version": "1.0.0",
  "description": "VLAD OS — assistant personnel vocal sur Claude Code, avec HUD et widgets. © Ts8r Studio",
  "private": true,
  "scripts": {
    "setup": "bash setup.sh",
    "ui": "vite",
    "ui:preview": "vite preview",
    "build": "vite build",
    "bridge": "VLAD_PYTHON=${VLAD_PYTHON:-.venv/bin/python} node voice/vlad-server.js",
    "vlad": "concurrently -k -n bridge,hud \"npm:bridge\" \"npm:ui\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "gsap": "^3.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "vite": "^5.4.11"
  },
  "license": "SEE LICENSE IN LICENSE",
  "author": "Ts8r Studio"
}
